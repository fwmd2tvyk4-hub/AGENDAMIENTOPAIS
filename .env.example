# Variables de Entorno para la Base de Datos (PostgreSQL en Railway)
DATABASE_URL=postgresql://usuario:password@host:puerto/tu_bd

# Contraseña maestra para el panel de administración
ADMIN_PASSWORD=demo_pragma_2024

# Puerto local del servidor (por defecto 3000)
PORT=3000

# ==========================================
# CONFIGURACIÓN RESEND (FASE 4)
# ==========================================
# Tu API Key de Resend (reemplaza por la tuya si quieres probar envíos reales)
RESEND_API_KEY=re_123456789

# Dominio / Remitente autorizado en Resend (por defecto el de pruebas de Resend)
EMAIL_FROM=Pragma Citas <onboarding@resend.dev>

# Correo donde la clínica recibe las notificaciones de nuevas citas
CLINICA_EMAIL=clinica@pragma.ai

# URL pública de la aplicación para el enlace de cancelación en el correo
PUBLIC_URL=http://localhost:3000
